# ─────────────────────────────────────────────────────────────
# Vanguard Signal — Environment Configuration
# Copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
VS_ENV=development
VS_LOG_LEVEL=INFO

# ── Database (PostgreSQL) ────────────────────────────────────
VS_DB_HOST=localhost
VS_DB_PORT=5432
VS_DB_NAME=vanguard_signal
VS_DB_USER=vanguard
VS_DB_PASSWORD=changeme
VS_DB_ECHO=false

# ── Ingestion Scheduler ─────────────────────────────────────
VS_INGEST_INTERVAL=3600
VS_GTRENDS_TIMEFRAME=now 7-d
VS_GTRENDS_GEO=
VS_WIKI_LOOKBACK_DAYS=30
VS_WIKI_GRANULARITY=daily

# ── Reddit Connector (optional) ─────────────────────────────
VS_REDDIT_CLIENT_ID=
VS_REDDIT_CLIENT_SECRET=
VS_REDDIT_USER_AGENT=vanguard_signal:v0.1 (by /u/vanguard)
VS_REDDIT_SUBREDDITS=all
VS_REDDIT_SEARCH_LIMIT=100

# ── Semantic Engine (Phase 2) ────────────────────────────────
VS_SEMANTIC=false
VS_SBERT_MODEL=all-MiniLM-L6-v2
VS_MIN_CLUSTER_SIZE=3
VS_DRIFT_THRESHOLD=0.15

# ── Phase Flags ──────────────────────────────────────────────
VS_BACKTEST=false
VS_RL_FEEDBACK=false

# ── JWT Authentication ───────────────────────────────────────
VS_JWT_SECRET=vanguard-dev-secret-change-me
VS_JWT_EXPIRE_MINUTES=480
VS_RL_LEARNING_RATE=1.0
VS_RL_PRIORS_PATH=data/rl_priors.json

# ── Grafana / Prometheus ─────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Notifications (all optional) ─────────────────────────────────
# Slack
VS_NOTIFY_SLACK_URL=
# Email (SMTP)
VS_NOTIFY_EMAIL_HOST=
VS_NOTIFY_EMAIL_PORT=587
VS_NOTIFY_EMAIL_USER=
VS_NOTIFY_EMAIL_PASS=
VS_NOTIFY_EMAIL_FROM=alerts@vanguard-signal.local
VS_NOTIFY_EMAIL_TO=
# Custom Webhook
VS_NOTIFY_WEBHOOK_URL=
VS_NOTIFY_WEBHOOK_SECRET=

# ── Trading & Market Data ────────────────────────────────────
# Alpaca API (for paper trading)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
